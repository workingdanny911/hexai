{
    "extends": "@hexaijs/tooling/tsconfig/base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": ["src"],
    // Fixture projects are inputs the generator reads, not part of this
    // package's program. Some are invalid on purpose, so keep them out of
    // type checking.
    "exclude": ["node_modules", "dist", "src/fixtures"]
}
